<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>FastCDC</RootNamespace>
		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

		<Authors>Azurshi</Authors>
		<Version Condition="'$(Configuration)' == 'Debug'">0.1.5-preview</Version>
		<Version Condition="'$(Configuration)' == 'Release'">0.1.5</Version>
		<Description> Native implementation of Fast CDC in C#</Description>
	</PropertyGroup>
</Project>